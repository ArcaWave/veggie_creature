# Google Gemini (Nano Banana) API 키 — https://aistudio.google.com/apikey 에서 발급
# 아래 줄을 .env 파일에 복사하고 키를 채우세요. 키가 없으면 앱은 원본 사진으로 진행됩니다.
GEMINI_API_KEY=

# (선택) 이미지 모델 변경. 기본값: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (선택) "깨우기" 영상 모델. 기본값: veo-3.1-lite-generate-preview (가장 저렴)
# 더 생생하게: veo-3.1-fast-generate-preview / veo-3.1-generate-preview
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
