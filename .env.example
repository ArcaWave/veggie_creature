# Google Gemini (Nano Banana) API 키 — https://aistudio.google.com/apikey 에서 발급
# 아래 줄을 .env 파일에 복사하고 키를 채우세요. 키가 없으면 앱은 원본 사진으로 진행됩니다.
GEMINI_API_KEY=

# (선택) 이미지 모델 변경. 기본값: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# (선택) "깨우기" 영상 모델. 기본값: veo-3.1-lite-generate-preview (가장 저렴)
# 더 생생하게: veo-3.1-fast-generate-preview / veo-3.1-generate-preview
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview

# Typecast (typecast.ai) TTS — 캐릭터 목소리(영어). https://typecast.ai/developers/api
# 키가 없으면 브라우저 내장 음성으로 자동 폴백됩니다.
TYPECAST_API_KEY=
# 목소리 선택: 키 입력 후 dev 서버에서 http://localhost:5180/api/voices 를 열어
# 마음에 드는 영어 목소리의 voice_id를 골라 넣으세요.
TYPECAST_VOICE_ID=
# (선택) 모델: ssfm-v21(안정) | ssfm-v30(최신). 기본 ssfm-v21
TYPECAST_MODEL=ssfm-v21
